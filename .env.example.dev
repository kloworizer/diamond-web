# Development Environment Configuration
# Copy this file to .env and update the values for local development

# Django Settings
SECRET_KEY=django-insecure-dev-key-change-in-production
DEBUG=True
ENVIRONMENT=dev
ALLOWED_HOSTS=127.0.0.1,localhost

# CSRF Configuration
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Database Configuration (SQLite for development)
DB_ENGINE=sqlite3
# Uncomment below to use PostgreSQL instead
# DB_ENGINE=postgresql
# DB_NAME=diamond_web_dev
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432

# Email Configuration (console output in development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_email@example.com
# EMAIL_HOST_PASSWORD=your_app_password

# db seed
DB_SEED_ENABLED=1
# SEED_TABLE=KATEGORI_WILAYAH_DATA,JENIS_TABEL_DATA,PERIODE_PENGIRIMAN_DATA,STATUS_DATA_DATA,BENTUK_DATA_DATA,CARA_PENYAMPAIAN_DATA,MEDIA_BACKUP_DATA,STATUS_PENELITIAN_DATA,USERS_DATA,

# django-dbbackup: local filesystem storage (default)
BACKUP_DIR=backups
# BACKUP_STORAGE=django.core.files.storage.FileSystemStorage


# Ollama — menu Chat (asisten database read-only)
# Chatbot hanya boleh menjalankan SELECT ke tabel bisnis; tabel auth_* dan
# django_* diblokir sehingga password/grup pengguna tidak dapat dibaca.
OLLAMA_ENABLED=True
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=300
OLLAMA_TEMPERATURE=0
# KV cache = num_ctx x OLLAMA_NUM_PARALLEL (default 2), dialokasikan sekaligus.
# 4096 butuh ~1 GiB, 8192 butuh ~2 GiB di luar ~4.7 GiB model. Nilai terlalu
# besar membuat runner Ollama gagal ("exit status 2") di mesin tanpa GPU.
OLLAMA_NUM_CTX=4096

# Batas pengaman chatbot
CHAT_MAX_ROWS=200
CHAT_MAX_ROWS_TO_MODEL=30
CHAT_QUERY_TIMEOUT=15
CHAT_HISTORY_TURNS=6
