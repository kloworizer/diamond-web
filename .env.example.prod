# Production Environment Configuration
# Copy this file to .env and update the values for production deployment

# Django Settings
SECRET_KEY=your-long-random-secret-key-here-change-this
DEBUG=False
ENVIRONMENT=prod
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# CSRF Configuration
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Set to "none" when the app is served over plain HTTP (e.g. a bare internal
# IP). Browsers ignore Cross-Origin-Opener-Policy on untrustworthy origins and
# log a console warning on every page; this drops the header instead.
# SECURE_CROSS_ORIGIN_OPENER_POLICY=none

# Database Configuration (PostgreSQL recommended for production)
DB_ENGINE=postgresql
DB_NAME=diamond_web_prod
DB_USER=diamond_web_user
DB_PASSWORD=your_secure_database_password
DB_HOST=your_database_host
DB_PORT=5432

# Email Configuration (SMTP for production)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_specific_password

# django-dbbackup: backup storage location
BACKUP_DIR=/var/backups/diamond
# For cloud storage (S3-compatible), uncomment and configure:
# BACKUP_STORAGE=storages.backends.s3boto3.S3Boto3Storage
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_STORAGE_BUCKET_NAME=diamond-backups
# AWS_S3_REGION_NAME=us-east-1
# AWS_DEFAULT_ACL=private

# Ollama — menu Chat (asisten database read-only)
# Chatbot hanya boleh menjalankan SELECT ke tabel bisnis; tabel auth_* dan
# django_* diblokir sehingga password/grup pengguna tidak dapat dibaca.
# Set OLLAMA_ENABLED=False untuk mematikan menu Chat di produksi.
OLLAMA_ENABLED=True
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=300
OLLAMA_TEMPERATURE=0
# KV cache = num_ctx x OLLAMA_NUM_PARALLEL (default 2), dialokasikan sekaligus.
# 4096 butuh ~1 GiB, 8192 butuh ~2 GiB di luar ~4.7 GiB model. Nilai terlalu
# besar membuat runner Ollama gagal ("exit status 2") di mesin tanpa GPU.
OLLAMA_NUM_CTX=4096

# Batas pengaman chatbot
CHAT_MAX_ROWS=200
CHAT_MAX_ROWS_TO_MODEL=30
CHAT_QUERY_TIMEOUT=15
CHAT_HISTORY_TURNS=6
